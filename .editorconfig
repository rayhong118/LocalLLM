# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python files (PEP 8 standard: 4 spaces)
[*.py]
indent_style = space
indent_size = 4

# Frontend and Web files (2 spaces standard)
[*.{js,jsx,ts,tsx,json,css,html,yaml,yml,md}]
indent_style = space
indent_size = 2
